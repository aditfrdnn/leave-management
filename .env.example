# Leave API base URL (leave-service, Laravel). No trailing /api — paths already start with /api.
# Production API: https://lvr-api.pdi-ptcs.com   Local: http://127.0.0.1:8000
NEXT_PUBLIC_DEV_SERVER_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PROD_SERVER_URL=https://lvr-api.pdi-ptcs.com

# Name of the httpOnly cookie that holds the bearer token.
TOKEN_KEY=auth_token
