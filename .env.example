# Leave API base URL (leave-service, Laravel). No trailing /api — paths already start with /api.
# Production API: https://lvr-api.pdi-ptcs.com   Local: http://127.0.0.1:8000
NEXT_PUBLIC_DEV_SERVER_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PROD_SERVER_URL=https://lvr-api.pdi-ptcs.com

# --- Sign-in through IAM (OpenID Connect, src/configs/iam.server.ts) ---
# Public issuer, exactly as in tokens. Local: http://localhost:3000
IAM_ISSUER=https://iam.pdi-ptcs.com
# Where this server reaches IAM (token endpoint, JWKS). Usually the same as the issuer.
IAM_BACKEND_URL=https://iam.pdi-ptcs.com
# This app's own origin; IAM redirects to {HRLITE_URL}/auth/callback and, after logout, {HRLITE_URL}/signed-out.
HRLITE_URL=https://lvr.pdi-ptcs.com
# The hrlite-web client from the IAM Portal (Applications > HR Lite > Clients).
IAM_CLIENT_ID=hrlite-web
IAM_CLIENT_SECRET=
# Encrypts the session cookie: 32 random bytes, base64 (openssl rand -base64 32).
SESSION_SECRET=
# IAM Portal, linked where users and roles are managed.
NEXT_PUBLIC_IAM_CONSOLE_URL=https://iam-portal.pdi-ptcs.com

# --- Live updates (Laravel Reverb on the leave API) ---
# REVERB_APP_KEY of laravel-hrlite, and where browsers reach Reverb.
NEXT_PUBLIC_REVERB_KEY=
NEXT_PUBLIC_REVERB_HOST=lvr-api.pdi-ptcs.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
